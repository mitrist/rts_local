{
  "manifest_version": 3,
  "name": "RTS Cookie Bridge",
  "version": "1.4.0",
  "description": "Отправка cookie *.rts-tender.ru в сервис rts_tender",
  "permissions": ["cookies", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RTS Cookie Bridge"
  }
}
