# VM: rts_tender web UI (proxy → 127.0.0.1:8765)
# Install: sudo cp deploy/rts_tender_vm.nginx /etc/nginx/sites-available/rts_tender
#          sudo ln -sf /etc/nginx/sites-available/rts_tender /etc/nginx/sites-enabled/rts_tender
#          sudo nginx -t && sudo systemctl reload nginx
# TLS:     sudo certbot --nginx -d rts.raytec-log.pro

server {
    listen 80;
    listen [::]:80;
    server_name rts.raytec-log.pro;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}
