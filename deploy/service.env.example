# Пример /etc/rts-local/service.env — зеркало prod (/etc/rts-tender/service.env),
# пути и домен адаптированы под rts-local.
# Порт 8766: 8765 занят prod rts-tender на той же VM.

RTS_PROJECT_ROOT=/opt/rts_local/app
RTS_META_DIR=/var/lib/rts_local
RTS_STATE_FILE=/var/lib/rts_local/rts_invites_state.json
RTS_COOKIE_FILE=/etc/rts-local/cookies_rts.txt
RTS_PREOFFERS_FILE=/var/lib/rts_local/rts_preoffers.json
RTS_KTRU_COUNTRY_FILE=/opt/rts_local/app/country_origin.csv
EIS_ENV_FILE=/etc/rts-local/eis.env
EIS_STATE_FILE=/var/lib/rts_local/eis_ezt_state.json
EIS_ANALYTICS_DB=eis_analytics.sqlite3
RTS_PUBLIC_BASE_URL=https://rts-local.raytec-log.pro
RTS_WEB_PORT=8766
RTS_WEB_HOST=127.0.0.1
EIS_HTML_AUTO_FETCH=1
RTS_PREOFFER_TELEGRAM_NOTIFY=1
RTS_WEB_USERS_FILE=/etc/rts-local/web_users.txt
RTS_WEB_SESSION_SECRET=CHANGE_ME_TO_LONG_RANDOM_32PLUS_CHARS
RTS_WEB_HTTPS_ONLY=1
EIS_HISTORY_DB=/opt/rts_local/data/eis_history.sqlite3
RTS_COOKIE_INGEST_KEY=CHANGE_ME_LONG_RANDOM
RTS_PREOFFER_MAX_NOTIFY=0
RTS_PARTICIPATION_PRICE_ORD_ENABLED=0
RTS_PP_PARTICIPATE_REQUIRE_PREOFFER_CATALOG=0
RTS_WEB_PUBLIC_BASE_URL=https://rts-local.raytec-log.pro
RTS_AUTO_PARTICIPATE=0
RTS_AUTO_MONITOR_DRAFT=0
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
RTS_PP_MONITOR=1
RTS_PP_MONITOR_CRON=1
RTS_PP_MONITOR_SUPERVISOR=0
RTS_PP_MONITOR_INTERVAL_SEC=420
RTS_PP_MONITOR_FULL_PAGES=1

# Публикация ПП после черновика (подпись ЭП на ПК оператора через CryptoPro)
RTS_PP_PUBLISH_ENABLED=0
