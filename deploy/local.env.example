# Локальный запуск rts_local. Секреты сюда не класть: токен ЕРУЗ — в env.txt.
# tools/start_local.ps1 читает этот файл и делает пути абсолютными от корня репозитория.
# Иначе относительный EIS_ANALYTICS_DB сохраняется только по имени файла в RTS_META_DIR,
# а EIS_HISTORY_DB — только по имени файла в текущий каталог.

RTS_PROJECT_ROOT=.
RTS_META_DIR=data/local/meta
EIS_ANALYTICS_DB=data/local/eis_analytics.sqlite3
# Backfill ЕИС с прода (янв–май 2026). Новые RSS/HTML остаются в analytics выше.
EIS_HISTORY_DB=SQL/eis_history.sqlite3
EIS_ENV_FILE=env.txt

# Админка в меню — у этих логинов после входа. Файл учёток: web_users.txt
RTS_SETTINGS_ADMIN_USERS=admin,IPSokolova

RTS_WEB_HOST=127.0.0.1
# 8765 на этой машине может быть занят другим локальным сайтом.
RTS_WEB_PORT=8766

# RSS включается кнопкой на странице аналитики. HTML карточек — сразу после новых наблюдений.
EIS_HTML_AUTO_FETCH=1

# Локальный контур: черновики виртуальных ПП без публикации, без монитора ПП и авто-участия.
RTS_PP_PUBLISH_ENABLED=0
RTS_PP_MONITOR=0
RTS_AUTO_PARTICIPATE=0
RTS_AUTO_MONITOR_DRAFT=0
VIRTUAL_PP_POLL=0
