# VM (рядом с prod rts.raytec-log.pro на том же хосте):
#   sudo cp deploy/rts_local_vm.nginx /etc/nginx/sites-available/rts_local
#   sudo ln -sf /etc/nginx/sites-available/rts_local /etc/nginx/sites-enabled/rts_local
#   sudo nginx -t && sudo systemctl reload nginx
# TLS:
#   sudo certbot --nginx -d rts-local.raytec-log.pro
#
# Backend: 127.0.0.1:8766 (prod rts-tender занимает 8765)

server {
    listen 80;
    listen [::]:80;
    server_name rts-local.raytec-log.pro;

    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}
